# gateway_credits.yaml.example
#
# credits_engine 定价外置示例（深合并：只写要覆盖的键，其余沿用 credits_engine.py 内置默认值）。
# 启用方式（二选一）：
#   1. 复制为 backend/config/gateway_credits.yaml（无文件时走内置默认）；
#   2. 设环境变量 GATEWAY_CREDITS_FILE 指向任意 yaml 路径（相对路径基于 backend/config/ 解析）。
#
# 可覆盖的白名单键（其余键一律忽略，防止误改非配置状态）：
#   表：VIDEO_MODEL_TIERS / RESOLUTION_MAP / ASPECT_RATIO_MAP / DURATION_OPTIONS /
#       DRAMA_PIPELINE_PRICING / MUSIC_PRICING / COMICS_PRICING / INTERACTIVE_PRICING /
#       MODEL_REFERENCE_LIMITS / MODEL_ID_MAP / DRAMA_VIDEO_RATE_PER_SEC / QUICK_MODEL_RATE_PER_SEC
#   标量：SCRIPT_CHARS_PER_CREDIT / STORYBOARD_CHARS_PER_CREDIT / IMAGE_COST
# 派生总量（DRAMA_EPISODE_TOTAL / AGENT_PIPELINE_OVERHEAD / MUSIC_TOTAL / COMICS_TOTAL /
# INTERACTIVE_TOTAL）在覆盖后自动重算，无需手填。
MUSIC_PRICING:
  analyze:  {credits: 1,  label: 风格分析}
  generate: {credits: 8,  label: 音乐生成}
  compose:  {credits: 1,  label: 混音导出}
DRAMA_VIDEO_RATE_PER_SEC:
  420p: 5
  720p: 6
SCRIPT_CHARS_PER_CREDIT: 300
